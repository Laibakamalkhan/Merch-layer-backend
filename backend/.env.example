# Backend runtime configuration. Keep real values out of source control.
# Either DATABASE_URL or SUPABASE_DATABASE_URL may be used.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
SUPABASE_DATABASE_URL=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

BRONZE_BUCKET=commerce-bronze
USER_FILES_BUCKET=commerce-files
MAX_USER_FILE_BYTES=20971520

MAX_CONCURRENT_CONNECTIONS=5
MAX_PAGES_PER_RESOURCE=
# Frontend ka URL - confirmation email ka link yahin wapas aayega.
# Supabase Dashboard > Authentication > URL Configuration mein bhi yahi URL daalna zaroori hai.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Prototype product entitlements; change without editing code.
FREE_STORE_LIMIT=1
FREE_AI_QUERY_LIMIT_MONTHLY=100
ALLOW_DIRECT_PLAN_CHANGE=false
BILLING_CHECKOUT_URL=

# Frontend origin(s) allowed by CORS (comma separated). Add your deployed frontend URL too.
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com
