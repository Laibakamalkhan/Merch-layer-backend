# Frontend (Vite) - public client configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend runtime configuration reference (see backend/.env.example for details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
SUPABASE_DATABASE_URL=
ANALYST_DATABASE_URL=
DB_POOL_MAX=10

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY

AUTH_CACHE_TTL_SECONDS=30

LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b
GROQ_USE_SYSTEM_PROXY=false
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

BRONZE_BUCKET=commerce-bronze
USER_FILES_BUCKET=commerce-files
MAX_USER_FILE_BYTES=20971520

MAX_CONCURRENT_CONNECTIONS=5
MAX_PAGES_PER_RESOURCE=
TASK_RETENTION_SECONDS=3600

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

FREE_STORE_LIMIT=1
FREE_AI_QUERY_LIMIT_MONTHLY=100
MAX_WORKSPACES_PER_USER=3
ALLOW_DIRECT_PLAN_CHANGE=false
BILLING_CHECKOUT_URL=
